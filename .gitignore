# 의존성
node_modules/
.pnpm-store/

# 빌드 산출물
dist/
build/
.next/
.next-build/
out/
*.tsbuildinfo

# 환경변수 (절대 커밋하지 않는다 — API 키가 들어간다)
.env
.env.local
.env.*.local

# 로컬 DB 파일 (SQLite 사용 시)
*.db
*.db-journal
prisma/dev.db*

# 로그·캐시
*.log
npm-debug.log*
.turbo/
coverage/
.vitest/

# 에디터·OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Next.js 자동 생성 타입 파일
next-env.d.ts

# 수동으로 내려받는 원본 데이터 (용량이 크고 출처가 정부 사이트)
data/*
!data/README.md
# CSV 를 넣을 자리는 빈 폴더로 남겨 둔다 (README 가 이 경로를 안내한다)
!data/csv/
data/csv/*
!data/csv/.gitkeep
