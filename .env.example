# ─────────────────────────────────────────────────────────────
# .env.example — 이 파일을 복사해서 .env 로 만든 뒤 값을 채웁니다.
#   cp .env.example .env
# (setup.sh 가 자동으로 복사해 줍니다. .env 는 절대 깃에 올라가지 않습니다.)
# ─────────────────────────────────────────────────────────────

# ── 데이터베이스 ──────────────────────────────────────────────
# 기본값: docker compose 로 띄우는 로컬 MariaDB
DATABASE_URL="mysql://apt:aptpw@localhost:3306/apt_finder"

# ── 공공 API 키 ───────────────────────────────────────────────
# 없어도 됩니다. DEMO_MODE=true 이면 가짜 데이터로 전체 화면이 동작합니다.
# 국토교통부 아파트 실거래가 (https://www.data.go.kr)
MOLIT_API_KEY=""
# 카카오 로컬 API — REST 키(서버용)와 JavaScript 키(지도용)는 서로 다릅니다.
# https://developers.kakao.com
KAKAO_REST_KEY=""
NEXT_PUBLIC_KAKAO_JS_KEY=""

# ── 관리자 대시보드 ───────────────────────────────────────────
# 세션 서명용 비밀값. 아무 긴 문자열이나 가능하지만 운영 서버에서는 반드시 바꿉니다.
# 만드는 법: openssl rand -hex 32
ADMIN_SESSION_SECRET="local-dev-only-change-me-please-32chars"
# 최초 관리자 계정 (scripts/seed-admin.ts 가 만듭니다. 첫 로그인 시 변경이 강제됩니다.)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="12345"

# ── 수집 대상 지역 ────────────────────────────────────────────
# 시군구 코드 5자리를 쉼표로 구분해 적습니다. 전국을 매일 훑으면 API 한도를 넘깁니다.
# 코드 찾는 법: 서비스 화면에서 지역을 검색하면 sigunguCode 가 보입니다.
#   11680 = 서울 강남구, 41450 = 경기 하남시, 41117 = 수원시 영통구
COLLECT_SIGUNGU_CODES="11680,41450"

# ── 실행 모드 ─────────────────────────────────────────────────
# true  = 공공 API 를 부르지 않고 샘플 데이터로 동작 (API 키 승인 전 테스트용)
# false = 실제 공공 API 호출
DEMO_MODE=true

NODE_ENV=development
API_PORT=4000
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
